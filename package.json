{
  "name": "ultra-postultra-post",
  "version": "0.3.1",
  "private": true,
  "description": "Ứng dụng quản lý nội dung và lịch đăng Facebook Fanpage",
  "author": "Ultra PostUltra Post",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "build": "electron-builder --win portable --x64",
    "test:profiles": "node tests/profile-isolation.cjs",
    "test:lock": "node tests/lock-flow.cjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ultrapost.desktop",
    "productName": "Ultra PostUltra Post",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "desktop/assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Ultra-PostUltra-Post-${version}-Windows-x64.exe"
    }
  }
}
